{
  "name": "google-play-app-wizard",
  "version": "1.0.0",
  "private": true,
  "description": "A step-by-step, personalized guide to publishing an Android app on Google Play.",
  "scripts": {
    "build": "node scripts/build-web.js",
    "sync": "node scripts/build-web.js && npx cap sync android",
